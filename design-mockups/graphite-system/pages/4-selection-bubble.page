- elementId: code-outside
  elementType: text
  bounds:
  - 314
  - 236
  - 1060
  - 580
  content:
    fontSize: 13
    color: '#6F7987'
    fontFamily: *id001
    lineHeight: 1.65
    wrap: true
    text: "import torch\nimport torch.nn as nn\n\nclass MultiHeadAttention(nn.Module):\n    def __init__(self, hidden_size, heads):\n        super().__init__()\n        self.heads = heads\n        self.attention = nn.Linear(hidden_size, hidden_size)\n\n    def forward(self, query, key, value):\n        scores = query @ key.transpose(-2, -1)\n        weights = torch.softmax(scores, dim=-1)\n        return weights @ value\n\n# Each token learns which other tokens to attend to\n# Context shapes the meaning of the current token"
