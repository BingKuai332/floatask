{
  "name": "floatask",
  "productName": "浮问 FloatAsk",
  "version": "0.3.2",
  "description": "悬浮在任意窗口上的屏幕理解与追问助手",
  "main": "src/main/main.js",
  "author": "FloatAsk",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BingKuai332/floatask.git"
  },
  "homepage": "https://github.com/BingKuai332/floatask#readme",
  "bugs": {
    "url": "https://github.com/BingKuai332/floatask/issues"
  },
  "keywords": [
    "electron",
    "windows",
    "ai",
    "llm",
    "ocr",
    "screen-capture",
    "overlay",
    "desktop-app",
    "deepseek",
    "openai"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "start": "node scripts/launch.js",
    "predev": "node scripts/ensure-electron.js",
    "dev": "node scripts/launch.js --dev",
    "mock": "node scripts/mock-ai.js",
    "pack": "node scripts/ensure-electron.js && electron-packager . FloatAsk --platform=win32 --arch=x64 --out=dist --overwrite --asar --icon=resources/icon.ico --ignore=\"^/(dist|scripts|tests|\\.github|shots|docs|\\.npm-cache|\\.electron-cache|\\.userdata|\\.tmp-.*|mock-last-request\\.json|.*\\.log)$\" && node scripts/write-launchers.js",
    "test": "node scripts/test.js",
    "release:assets": "node scripts/release.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "45.1.0"
  }
}
